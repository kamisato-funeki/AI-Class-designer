{
  "name": "ai-class-designer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env ELECTRON=true vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:electron": "run-p type-check \"build-only:electron {@}\" -- && electron-builder",
    "preview": "vite preview",
    "build-only": "vite build",
    "build-only:electron": "cross-env ELECTRON=true vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@langchain/core": "^1.1.29",
    "@langchain/openai": "^1.2.11",
    "@types/marked": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pdf": "^2.0.10",
    "@vue-office/pptx": "^1.0.1",
    "ajax": "^0.0.4",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.6",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "langchain": "^1.2.28",
    "lodash": "^4.17.23",
    "lucide-vue-next": "^0.575.0",
    "marked": "^17.0.5",
    "pinia": "^3.0.4",
    "simple-mind-map": "^0.14.0-fix.1",
    "splitpanes": "^4.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.29",
    "vue-cropper": "^1.1.4",
    "vue-demi": "^0.14.10",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.3",
    "vue3-video-play": "^1.3.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.10.13",
    "@types/splitpanes": "^2.2.6",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.aiclassdesigner.app",
    "productName": "笔耕",
    "icon": "src/assets/icons/笔耕01.png",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "icon": "src/assets/icons/笔耕01.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
